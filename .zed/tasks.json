[
  {
    "label": "C/C++ Docs: build/install proxy (Windows)",
    "command": "powershell.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/install-proxy.ps1"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  },
  {
    "label": "C/C++ Docs: build/install proxy (Linux / WSL)",
    "command": "cargo",
    "args": ["install", "--path", "crates/proxy", "--locked", "--force"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  }
]
